# Copy to .env for local dev:  cp .env.example .env
# On Railway, set these as service variables instead (Variables tab).

# ---- Required ----------------------------------------------------------------
# The shared secret for the API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start without it.
AUTH_TOKEN=change-me-to-a-long-random-string

# ---- AI categorization (optional but recommended) ----------------------------
# Without ANY of these, anything the merchant rules don't recognise lands in
# "Needs review" instead of being auto-categorised. Tried in this order, each
# one skipped if unset or if it fails (e.g. a daily quota running out):
# Claude -> Gemini -> Azure OpenAI.
ANTHROPIC_API_KEY=sk-ant-...
# Override if you want a cheaper/faster model, e.g. claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# Free tier, no card needed — the same key also powers photo receipt
# scanning (see receipt_scan.py), so there's a good chance it's already set.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash

# Needs a deployed model in an Azure OpenAI / AI Foundry resource — not a
# free tier, but a fallback if Gemini's daily quota runs dry during a big
# backfill. DEPLOYMENT is the name you gave the model when deploying it in
# Azure, not necessarily the model's own name (e.g. "gpt-5-mini-1").
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ---- Gmail poller (optional) --------------------------------------------------
# Lets the backend read bank-alert emails automatically (some banks email
# transactions instead of texting them). From a Google Cloud OAuth client
# (Web application type) — redirect URI must be <your-render-url>/gmail/auth/callback.
# After setting these, visit /gmail/auth/start?token=<AUTH_TOKEN> once in a
# browser to connect the Gmail account. See backend/gmail_poll.py.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://your-app.onrender.com/gmail/auth/callback

# ---- Database ----------------------------------------------------------------
# Leave unset locally to use ./budget.db (SQLite).
# Railway's Postgres plugin sets this automatically — don't set it by hand there.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Misc --------------------------------------------------------------------
# Your wall-clock timezone; budget months are cut on these boundaries.
TZ_NAME=Asia/Kolkata
# Comma-separated allowed origins. Set to your frontend URL after deploying.
CORS_ORIGINS=*
